# ===============================================================
#  ENVIRONMENT VARIABLES  (copy this file to .env.local)
# ===============================================================
#  Only variables prefixed with VITE_ are exposed to the client.
#  Do NOT put real values here — this file is committed as a template.
#  Put real values in .env.local (git-ignored) and in Vercel:
#  Project → Settings → Environment Variables (Production + Preview).
# ===============================================================

# ---- Firebase (projects/categories/about storage + admin auth) ----
# Firebase console → Project settings → General → "Your apps" → SDK config.
# The Firebase web config is public by design; write access is protected
# by Firestore security rules (firestore.rules) + Firebase Auth.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Image uploads -------------------------------------------------
# Leave unset (default): uploaded images are compressed in the browser
# and stored inline in Firestore — works on the FREE / Spark plan.
# Set to "true" ONLY if you have upgraded to the Blaze plan and enabled
# Firebase Storage (then also publish storage.rules).
VITE_FIREBASE_USE_STORAGE=

# ---- Local-only fallback (optional) ------------------------------
# Used ONLY when the Firebase vars above are absent. Lets you open the
# /admin dashboard locally against browser-storage data. Not a real
# security boundary — leave unset in production when using Firebase.
VITE_ADMIN_PASSCODE=
