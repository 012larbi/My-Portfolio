rules_version = '2';

// ===============================================================
//  Firebase Storage rules  —  OPTIONAL
// ===============================================================
//  You only need this if you set VITE_FIREBASE_USE_STORAGE=true.
//  By default the app stores uploaded images inline in Firestore,
//  which works on the free (Spark) plan and needs NO Storage setup.
//
//  Firebase Storage requires the Blaze plan on newer projects.
//  If you do use it: Firebase console → Storage → "Get started"
//  (creates the bucket) → Rules tab → paste this → Publish.
//
//  - Anyone can READ images (they are shown on the public site).
//  - Only a signed-in user can UPLOAD, and only image files up to 5 MB.
// ===============================================================

service firebase.storage {
  match /b/{bucket}/o {

    match /{folder}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
